{
  "schema_version": 1,
  "dockerfile": "docker/Dockerfile",
  "target": "production",
  "platform": "linux/amd64",
  "service": {
    "compose_files": [
      "docker/docker-compose.yml",
      "docker/docker-compose.prod.yml"
    ],
    "deployed_compose_files": [
      "docker/docker-compose.yml",
      "docker/docker-compose.prod.yml",
      "docker/docker-compose.npm.yml"
    ],
    "deployed_sidecars": [
      {
        "name": "pubtator-postgres",
        "image": "docker.io/pgvector/pgvector@sha256:1963bc48febf543433baa1ce3edcc6cc08154de722e22495f86681cc9a849026"
      }
    ],
    "name": "pubtator-link",
    "container_port": 8000,
    "health_path": "/health",
    "mcp_path": "/mcp",
    "startup_timeout_seconds": 180,
    "auxiliary": [
      {
        "name": "pubtator-postgres",
        "role": "database",
        "egress": "approved-networks",
        "user": "999:999",
        "writable_targets": [
          "/var/lib/postgresql",
          "/var/run/postgresql",
          "/tmp"
        ],
        "read_only_targets": [],
        "healthcheck_test": [
          "CMD-SHELL",
          "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""
        ]
      }
    ]
  },
  "data": {
    "mode": "none",
    "image_allowlist": [
      "opt/venv/lib/python3.14/site-packages/beartype/_check/cls/hint/data/__init__.py",
      "opt/venv/lib/python3.14/site-packages/beartype/_check/cls/hint/data/hintdataabc.py",
      "opt/venv/lib/python3.14/site-packages/beartype/_check/cls/hint/data/hintdatacode.py",
      "opt/venv/lib/python3.14/site-packages/beartype/_check/cls/hint/data/hintdataerror.py"
    ]
  },
  "definitions": {
    "contract": "data-independent"
  },
  "smoke": {
    "profile": "postgres-bundle"
  }
}
